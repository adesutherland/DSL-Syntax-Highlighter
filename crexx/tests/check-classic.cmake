cmake_minimum_required(VERSION 3.24)
foreach(required VM IMAGE SAMPLE WORK_ROOT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_ROOT}")
set(request_file "${WORK_ROOT}/classic-request.txt")

function(add_frame variable payload)
  string(LENGTH "${payload}" length)
  math(EXPR hex "${length}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${hex}" 2 -1 hex)
  string(LENGTH "${hex}" digits)
  math(EXPR zeros "8 - ${digits}")
  string(REPEAT "0" ${zeros} padding)
  set(${variable} "${${variable}}${padding}${hex}${payload}" PARENT_SCOPE)
endfunction()

function(take_frame buffer_name frame_name)
  string(LENGTH "${${buffer_name}}" available)
  if(available LESS 8)
    message(FATAL_ERROR "Short Classic endpoint reply header")
  endif()
  string(SUBSTRING "${${buffer_name}}" 0 8 hex)
  if(NOT hex MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "Invalid Classic endpoint reply header")
  endif()
  math(EXPR length "0x${hex}")
  math(EXPR needed "8 + ${length}")
  if(available LESS needed)
    message(FATAL_ERROR "Short Classic endpoint reply body")
  endif()
  string(SUBSTRING "${${buffer_name}}" 8 ${length} extracted)
  string(SUBSTRING "${${buffer_name}}" ${needed} -1 tail)
  set(${buffer_name} "${tail}" PARENT_SCOPE)
  set(${frame_name} "${extracted}" PARENT_SCOPE)
endfunction()

function(check_tree reply extent expected_diagnostics)
  if("${reply}" STREQUAL "0")
    message(FATAL_ERROR "Classic endpoint refused admitted source")
  endif()
  string(REPLACE "|" ";" fields "${reply}")
  list(GET fields 0 records)
  math(EXPR last "${records} - 1")
  set(cursor 0)
  set(roots 0)
  set(containers 0)
  set(diagnostics 0)
  foreach(index RANGE 0 ${last})
    math(EXPR base "1 + ${index} * 7")
    math(EXPR pos_index "${base} + 1")
    math(EXPR len_index "${base} + 2")
    math(EXPR sev_index "${base} + 4")
    math(EXPR code_index "${base} + 5")
    list(GET fields ${base} kind)
    list(GET fields ${pos_index} position)
    list(GET fields ${len_index} length)
    list(GET fields ${sev_index} severity)
    list(GET fields ${code_index} code)
    if(kind GREATER_EQUAL 70 AND kind LESS 100)
      math(EXPR containers "${containers} + 1")
    endif()
    if(kind STREQUAL "71" AND position STREQUAL "0" AND length STREQUAL "${extent}")
      math(EXPR roots "${roots} + 1")
    endif()
    if(kind GREATER_EQUAL 33 AND kind LESS 70 AND NOT kind STREQUAL "34")
      if(NOT position EQUAL cursor OR length LESS 1)
        message(FATAL_ERROR "Classic endpoint lost ordered complete source coverage")
      endif()
      math(EXPR cursor "${cursor} + ${length}")
    endif()
    if(NOT code STREQUAL "")
      if(NOT code STREQUAL "434c41535349435f494e505554" OR NOT severity STREQUAL "3")
        message(FATAL_ERROR "Classic endpoint changed original input diagnostic category")
      endif()
      math(EXPR diagnostics "${diagnostics} + 1")
    endif()
  endforeach()
  if(NOT roots EQUAL 1 OR NOT containers EQUAL 1 OR NOT cursor EQUAL extent)
    message(FATAL_ERROR "Classic endpoint changed flat lexical root/extent")
  endif()
  if(expected_diagnostics AND diagnostics EQUAL 0)
    message(FATAL_ERROR "Classic endpoint lost invalid-source diagnostics")
  elseif(NOT expected_diagnostics AND NOT diagnostics EQUAL 0)
    message(FATAL_ERROR "Classic endpoint diagnosed clean source")
  endif()
endfunction()

function(check_leaf reply expected_kind expected_position expected_length expected_severity expected_code)
  string(REPLACE "|" ";" fields "${reply}")
  list(GET fields 0 records)
  math(EXPR last "${records} - 1")
  foreach(index RANGE 0 ${last})
    math(EXPR base "1 + ${index} * 7")
    math(EXPR pos_index "${base} + 1")
    math(EXPR len_index "${base} + 2")
    math(EXPR sev_index "${base} + 4")
    math(EXPR code_index "${base} + 5")
    list(GET fields ${base} kind)
    list(GET fields ${pos_index} position)
    list(GET fields ${len_index} length)
    list(GET fields ${sev_index} severity)
    list(GET fields ${code_index} code)
    if(kind STREQUAL expected_kind AND position STREQUAL expected_position AND
        length STREQUAL expected_length AND severity STREQUAL expected_severity AND
        code STREQUAL expected_code)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Classic endpoint lost exact leaf ${expected_kind}:${expected_position}:${expected_length}:${expected_severity}:${expected_code}")
endfunction()

file(READ "${SAMPLE}" sample)
string(REGEX MATCHALL "\n" sample_lines "${sample}")
list(LENGTH sample_lines line_count)
string(HEX "${sample}" sample_hex)
# The sample has one two-byte scalar; all remaining characters are ASCII.
string(LENGTH "${sample}" sample_bytes)
math(EXPR sample_extent "${sample_bytes} - 1")
set(clean "say 'ok'\n")
set(damaged "say 'λ'\n[\n")
set(unicode "/* λ */\r\nsay '😀'\r\n")
set(mapped "options levelc srcmap\nsay 'x'\n")
foreach(name IN ITEMS clean damaged unicode mapped)
  string(HEX "${${name}}" ${name}_hex)
endforeach()
set(request "")
add_frame(request "I|1|${line_count}|73616d706c65|${sample_hex}|")
add_frame(request "I|1|2|65646974|${damaged_hex}|")
add_frame(request "I|1|2|756e69636f6465|${unicode_hex}|")
add_frame(request "I|2|2|65646974|${mapped_hex}|")
add_frame(request "I|2|1|65646974|${clean_hex}|")
add_frame(request "I|2|2|756e69636f6465|${unicode_hex}|")
# Preview appends '[' before LF in edit v2. The committed edit still starts
# from v2 and inserts one space, yielding exactly "say  'ok'\n" at v3.
add_frame(request "H|2|65646974|2|3|70726576696577|1|c|0|8|0|5b")
add_frame(request "D|2|65646974|2|3||1|c|0|3|0|20")
file(WRITE "${request_file}" "${request}")
execute_process(COMMAND "${VM}" --no-autoload "${IMAGE}" -a --stdio
  INPUT_FILE "${request_file}" OUTPUT_VARIABLE output ERROR_VARIABLE errors
  RESULT_VARIABLE status TIMEOUT 60)
file(REMOVE "${request_file}")
set(expected_errors "DSLSH_CLASSIC_SRCMAP: original-byte projection is unavailable\n")
if(NOT status STREQUAL "0" OR NOT errors STREQUAL expected_errors)
  string(SUBSTRING "${errors}" 0 512 excerpt)
  message(FATAL_ERROR "Classic endpoint failed: rc=${status}; ${excerpt}")
endif()
foreach(name IN ITEMS sample damaged unicode refused clean repeated hypothesis delta)
  take_frame(output ${name}_reply)
endforeach()
if(NOT output STREQUAL "")
  message(FATAL_ERROR "Classic endpoint produced extra reply bytes")
endif()
check_tree("${sample_reply}" "${sample_extent}" FALSE)
check_tree("${damaged_reply}" 10 TRUE)
check_tree("${unicode_reply}" 18 FALSE)
if(NOT refused_reply STREQUAL "0")
  message(FATAL_ERROR "Classic endpoint admitted active SRCMAP without exact byte projection")
endif()
check_tree("${clean_reply}" 9 FALSE)
check_tree("${repeated_reply}" 18 FALSE)
if(NOT repeated_reply STREQUAL unicode_reply)
  message(FATAL_ERROR "Classic endpoint leaked observations between documents")
endif()
check_tree("${hypothesis_reply}" 10 TRUE)
check_leaf("${hypothesis_reply}" 36 8 1 3 "434c41535349435f494e505554")
check_tree("${delta_reply}" 10 FALSE)
check_leaf("${delta_reply}" 41 0 3 0 "")
check_leaf("${delta_reply}" 33 3 2 0 "")
check_leaf("${delta_reply}" 39 5 4 0 "")
check_leaf("${delta_reply}" 47 9 1 0 "")
message(STATUS "DSLSH_CLASSIC_STDIO|requests=8|failures=0")
