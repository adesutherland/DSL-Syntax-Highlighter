/* MIT licence. Synchronous eight-hex-byte STDIO transport for B parser services. */
options levelb
namespace dslshstdio expose run
import rxfnsb
import dslshsession

/** 0 complete, 1 EOF before any byte, 2 incomplete/error; no unbounded reads. */
readexact: procedure = .binary
  arg file = .int, count = .int, expose status = .int
  result = .binary; status = 0; read_error = 0; eof = 0
  do while <blen>(result) < count
    remaining = count - <blen>(result)
    chunk = .binary
    assembler freadb chunk,file,remaining
    assembler ferror read_error,file
    if read_error <> 0 then do
      status = 2; return result
    end
    if <blen>(chunk) = 0 then do
      assembler feof eof,file
      if eof <> 0 & <blen>(result) = 0 then status = 1
      else status = 2
      return result
    end
    call binappend result,chunk
  end
  return result

headerlength: procedure = .int
  arg header = reference .binary, maximum = .int
  bytes = dereference header
  if <blen>(bytes) <> 8 | maximum < 0 then return -1
  value = 0
  do i = 0 to 7
    byte = <at..u8>(i) bytes; digit = -1
    if byte >= 48 & byte <= 57 then digit = byte - 48
    else if byte >= 65 & byte <= 70 then digit = byte - 55
    else if byte >= 97 & byte <= 102 then digit = byte - 87
    if digit < 0 | digit > maximum then return -1
    if value > (maximum - digit) <idiv> 16 then return -1
    value = value * 16 + digit
  end
  return value

frameheader: procedure = .binary
  arg length = .int
  text = ''; table = '0123456789abcdef'
  do 8
    text = substr(table,(length <mod> 16) + 1,1) || text
    length = length <idiv> 16
  end
  return text as .binary

diagnostic: procedure = .void
  arg file = .int, message = .string
  if file = 0 then return
  bytes = (substr(message,1,min(length(message),1024)) || '0a'x) as .binary
  ignored = 0
  assembler fwriteb file,bytes
  assembler fflush ignored,file
  return

/**
 * Borrow the VM's standard handles. Requests and current token/C| replies are
 * ASCII: source and messages are hex. No raw-newline EP config is selected, so
 * this does not claim general binary STDIO support on Windows text-mode CRTs.
 * Return 0 for clean boundary EOF, 2 for ingress failure, 3 for output failure.
 */
run: procedure = .int
  arg service = reference .dslshsession..service, maximum = 8388608
  input = 0; output = 0; errors = 0; read_status = 0; write_error = 0; flush_error = 0
  input_name = 'stdin'; output_name = 'stdout'; error_name = 'stderr'
  read_mode = 'rb'; write_mode = 'wb'
  assembler fopen input,input_name,read_mode
  assembler fopen output,output_name,write_mode
  assembler fopen errors,error_name,write_mode
  if input = 0 | output = 0 | maximum < 1 | maximum > 2147483647 then return 2
  do
    server = dereference service
    do forever
      header = readexact(input,8,read_status)
      if read_status = 1 then return 0
      if read_status <> 0 then do
        call diagnostic(errors,'DSLSH_FRAME: truncated header'); return 2
      end
      amount = headerlength(reference header,maximum)
      if amount < 0 then do
        call diagnostic(errors,'DSLSH_FRAME: invalid or over-budget header'); return 2
      end
      payload = readexact(input,amount,read_status)
      if read_status <> 0 then do
        call diagnostic(errors,'DSLSH_FRAME: truncated payload'); return 2
      end
      response = server.handle(reference payload)
      if server.status() <> 0 then call diagnostic(errors,server.error())
      if server.terminal() then return 2
      if <blen>(response) > maximum then do
        call diagnostic(errors,'DSLSH_FRAME: over-budget reply'); return 3
      end
      prefix = frameheader(<blen>(response))
      assembler fwriteb output,prefix
      assembler fwriteb output,response
      assembler ferror write_error,output
      assembler fflush flush_error,output
      if write_error <> 0 | flush_error <> 0 then return 3
    end
  on signal as problem
    call diagnostic(errors,'DSLSH_FAILURE: ' || problem.message())
    return 2
  end
  return 2
