# Own only atomic stdout publication; rxlang owns all grammar algorithms.
cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS RXLANG SPEC OUTPUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required} for grammar generation")
  endif()
endforeach()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
set(staging "${OUTPUT}.stage")
execute_process(COMMAND "${RXLANG}" --no-autoload "${SPEC}" --rxas
  RESULT_VARIABLE status OUTPUT_FILE "${staging}" ERROR_VARIABLE diagnostic
  TIMEOUT 900)
if(NOT status STREQUAL "0")
  file(REMOVE "${staging}")
  message(FATAL_ERROR "rxlang failed (${status}): ${diagnostic}")
endif()
if(NOT diagnostic STREQUAL "")
  message("${diagnostic}")
endif()
file(SIZE "${staging}" size)
if(size EQUAL 0)
  file(REMOVE "${staging}")
  message(FATAL_ERROR "rxlang produced empty RXAS")
endif()
file(RENAME "${staging}" "${OUTPUT}" RESULT status)
if(NOT status STREQUAL "0")
  file(REMOVE "${staging}")
  message(FATAL_ERROR "Cannot publish generated RXAS: ${status}")
endif()
