cmake_minimum_required(VERSION 3.24)

foreach(required VM SETTINGS_IMAGE WORK_ROOT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_ROOT}")
set(request_file "${WORK_ROOT}/examples-request.txt")

function(add_frame variable payload)
  string(LENGTH "${payload}" length)
  math(EXPR hex "${length}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${hex}" 2 -1 hex)
  string(LENGTH "${hex}" digits)
  math(EXPR zeros "8 - ${digits}")
  string(REPEAT "0" ${zeros} padding)
  set(${variable} "${${variable}}${padding}${hex}${payload}" PARENT_SCOPE)
endfunction()

function(take_frame buffer_name frame_name)
  string(LENGTH "${${buffer_name}}" available)
  if(available LESS 8)
    message(FATAL_ERROR "Short endpoint reply header")
  endif()
  string(SUBSTRING "${${buffer_name}}" 0 8 hex)
  if(NOT hex MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "Invalid endpoint reply header")
  endif()
  math(EXPR length "0x${hex}")
  math(EXPR needed "8 + ${length}")
  if(available LESS needed)
    message(FATAL_ERROR "Short endpoint reply body")
  endif()
  string(SUBSTRING "${${buffer_name}}" 8 ${length} extracted)
  string(SUBSTRING "${${buffer_name}}" ${needed} -1 tail)
  set(${buffer_name} "${tail}" PARENT_SCOPE)
  set(${frame_name} "${extracted}" PARENT_SCOPE)
endfunction()

# Each body is the maintained C token stream. Code fields are hex-encoded.
function(check_diagnostics reply expected)
  if("${reply}" STREQUAL "0")
    message(FATAL_ERROR "Endpoint refused an admitted example")
  endif()
  string(REPLACE "|" ";" fields "${reply}")
  list(GET fields 0 records)
  set(actual "")
  math(EXPR last "${records} - 1")
  foreach(index RANGE 0 ${last})
    math(EXPR base "1 + ${index} * 7")
    math(EXPR pos_index "${base} + 1")
    math(EXPR len_index "${base} + 2")
    math(EXPR sev_index "${base} + 4")
    math(EXPR code_index "${base} + 5")
    list(GET fields ${pos_index} position)
    list(GET fields ${len_index} extent)
    list(GET fields ${sev_index} severity)
    list(GET fields ${code_index} code)
    if(NOT code STREQUAL "")
      list(APPEND actual "${code}:${position}:${extent}:${severity}")
    endif()
  endforeach()
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Wrong exact diagnostic code/span/severity: ${actual}")
  endif()
endfunction()

set(bad "unknown = 1\nlimit = 100\n")
set(string_value "limit = \"lots\"\n")
set(clean "name = \"Ada\"\nlimit = 7\n")
string(HEX "${bad}" bad_hex)
string(HEX "${string_value}" string_hex)
string(HEX "${clean}" clean_hex)
set(request "")
add_frame(request "I|1|2|626164|${bad_hex}|")
add_frame(request "I|1|1|737472|${string_hex}|")
add_frame(request "I|1|2|676f6f64|${clean_hex}|")
file(WRITE "${request_file}" "${request}")
execute_process(
  COMMAND "${VM}" --no-autoload "${SETTINGS_IMAGE}"
  INPUT_FILE "${request_file}"
  OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE status
  TIMEOUT 15)
if(NOT status STREQUAL "0" OR NOT errors STREQUAL "")
  string(SUBSTRING "${errors}" 0 512 excerpt)
  message(FATAL_ERROR "Settings endpoint failed: rc=${status}; ${excerpt}")
endif()
take_frame(output bad_reply)
take_frame(output string_reply)
take_frame(output clean_reply)
if(NOT output STREQUAL "")
  message(FATAL_ERROR "Settings endpoint produced extra reply bytes")
endif()
check_diagnostics("${bad_reply}" "5345545f554e4b4e4f574e:0:7:2;5345545f52414e4745:20:3:3")
check_diagnostics("${string_reply}" "5345545f52414e4745:8:6:3")
check_diagnostics("${clean_reply}" "")
string(REPLACE "|" ";" clean_fields "${clean_reply}")
list(GET clean_fields 0 clean_records)
set(clean_names 0)
math(EXPR clean_last "${clean_records} - 1")
foreach(index RANGE 0 ${clean_last})
  math(EXPR base "1 + ${index} * 7")
  math(EXPR pos_index "${base} + 1")
  math(EXPR len_index "${base} + 2")
  list(GET clean_fields ${base} kind)
  list(GET clean_fields ${pos_index} position)
  list(GET clean_fields ${len_index} extent)
  if(kind STREQUAL "57" AND
      ((position STREQUAL "0" AND extent STREQUAL "4") OR
       (position STREQUAL "13" AND extent STREQUAL "5")))
    math(EXPR clean_names "${clean_names} + 1")
  endif()
endforeach()
if(NOT clean_names EQUAL 2)
  message(FATAL_ERROR "Clean settings keys lost their constant-identifier refinement")
endif()

set(php_count 0)
if(DEFINED PHP_IMAGE AND NOT PHP_IMAGE STREQUAL "")
  set(php "<?php\n$x = 1;\necho ($x);\n?>")
  string(HEX "${php}" php_hex)
  set(request "")
  add_frame(request "I|1|4|706870|${php_hex}|")
  file(WRITE "${request_file}" "${request}")
  execute_process(
    COMMAND "${VM}" --no-autoload "${PHP_IMAGE}"
    INPUT_FILE "${request_file}"
    OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE status
    TIMEOUT 15)
  if(NOT status STREQUAL "0" OR NOT errors STREQUAL "")
    string(SUBSTRING "${errors}" 0 512 excerpt)
    message(FATAL_ERROR "PHP endpoint failed: rc=${status}; ${excerpt}")
  endif()
  take_frame(output php_reply)
  if(NOT output STREQUAL "" OR php_reply STREQUAL "0")
    message(FATAL_ERROR "PHP endpoint failed to return one tree")
  endif()
  check_diagnostics("${php_reply}" "")
  string(REPLACE "|" ";" fields "${php_reply}")
  list(GET fields 0 records)
  set(group_count 0)
  set(file_count 0)
  set(php_keywords 0)
  set(php_variables 0)
  set(php_numbers 0)
  math(EXPR last "${records} - 1")
  foreach(index RANGE 0 ${last})
    math(EXPR base "1 + ${index} * 7")
    math(EXPR pos_index "${base} + 1")
    math(EXPR len_index "${base} + 2")
    list(GET fields ${base} kind)
    list(GET fields ${pos_index} position)
    list(GET fields ${len_index} extent)
    if(kind STREQUAL "74" AND position STREQUAL "19" AND extent STREQUAL "4")
      math(EXPR group_count "${group_count} + 1")
    endif()
    if(kind STREQUAL "71" AND position STREQUAL "0" AND extent STREQUAL "28")
      math(EXPR file_count "${file_count} + 1")
    endif()
    if(kind STREQUAL "41" AND position STREQUAL "14" AND extent STREQUAL "4")
      math(EXPR php_keywords "${php_keywords} + 1")
    endif()
    if(kind STREQUAL "54" AND
        ((position STREQUAL "6" OR position STREQUAL "20") AND extent STREQUAL "2"))
      math(EXPR php_variables "${php_variables} + 1")
    endif()
    if(kind STREQUAL "40" AND position STREQUAL "11" AND extent STREQUAL "1")
      math(EXPR php_numbers "${php_numbers} + 1")
    endif()
  endforeach()
  if(NOT group_count EQUAL 1 OR NOT file_count EQUAL 1 OR
      NOT php_keywords EQUAL 1 OR NOT php_variables EQUAL 2 OR NOT php_numbers EQUAL 1)
    message(FATAL_ERROR "PHP subset lost exact group/file spans or lexical categories")
  endif()
  set(php_count 1)
endif()

file(REMOVE "${request_file}")
message(STATUS "DSLSH_EXAMPLES|settings=3|php=${php_count}|failures=0")
